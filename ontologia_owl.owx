    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Actividad</AbbreviatedIRI>
        <Literal>Visita concreta d&apos;una ciutat: nom, tipus, durada, cost i prioritat.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Alojamiento</AbbreviatedIRI>
        <Literal>Servei d&apos;estada associat a una ciutat, amb categoria, qualitat, preu i compatibilitat familiar.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Ciudad</AbbreviatedIRI>
        <Literal>Destinacio candidata amb zona, continent, cost, seguretat, popularitat i etiquetes turistiques.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Etapa</AbbreviatedIRI>
        <Literal>Part d&apos;un paquet: ciutat concreta, dies d&apos;estada, allotjament i visites.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:PaqueteViaje</AbbreviatedIRI>
        <Literal>Solucio recomanada: dues o tres ciutats, dies per ciutat, transport, allotjament, visites, preu i preferencies complertes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Preferencia</AbbreviatedIRI>
        <Literal>Criteri no obligatori que permet puntuar i comparar plans: tren, llocs menys coneguts, qualitat.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Restriccion</AbbreviatedIRI>
        <Literal>Condicio obligatoria que un pla ha de complir: pressupost maxim, evitar avio, dies, qualitat minima.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Transporte</AbbreviatedIRI>
        <Literal>Connexio entre origen/desti o entre ciutats: mitja, cost, hores i ambit.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>:Usuario</AbbreviatedIRI>
        <Literal>Perfil del client: edat, grup, infants, pressupost, objectiu, restriccions i preferencies.</Literal>
    </AnnotationAssertion>
</Ontology>



